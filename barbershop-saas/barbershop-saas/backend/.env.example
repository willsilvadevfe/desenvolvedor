# Porta do servidor
PORT=3001

# URL do frontend (para liberar o CORS)
FRONTEND_URL=http://localhost:5173

# --- Configuração de e-mail (Gmail com Senha de App) ---
# 1. Ative a verificação em duas etapas na conta Google que vai enviar os e-mails
# 2. Gere uma "Senha de App" em https://myaccount.google.com/apppasswords
# 3. Cole a senha gerada (16 letras, sem espaços) em EMAIL_PASS
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=sua_senha_de_app_aqui
EMAIL_FROM="Barbearia <seuemail@gmail.com>"

# E-mail do barbeiro, que também recebe uma notificação de cada novo agendamento
BARBER_EMAIL=barbeiro@exemplo.com

# Senha simples para acessar a página do painel do barbeiro (/admin)
ADMIN_PASSWORD=troque_esta_senha

# Nome da barbearia (usado nos e-mails)
BARBERSHOP_NAME=Barbearia Estilo
