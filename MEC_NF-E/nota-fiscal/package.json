{
  "name": "nota-fiscal-mecanica",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "wait-on http://localhost:5173 && electron .",
    "dev:app": "concurrently -k \"npm:dev\" \"npm:electron\"",
    "build": "vite build",
    "start": "vite build && vite preview --open",
    "postinstall": "electron-builder install-app-deps",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-imask": "^7.6.1",
    "react-router-dom": "^7.18.5",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.11",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.mecanica.notafiscal",
    "productName": "Nota Fiscal Mecanica",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
